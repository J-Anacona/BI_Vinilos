                        "rawSql": "SELECT t.turno_nombre AS metric,\r\n       SUM(p.pacas_producidas) AS pacas\r\nFROM fact_produccion p\r\nJOIN dim_fecha d   USING (fecha_key)\r\nJOIN dim_maquina m USING (maquina_key)\r\nJOIN dim_turno t   USING (turno_key)\r\nWHERE d.anio = $anio\r\n  AND m.maquina_nombre IN ($maquina)\r\nGROUP BY t.turno_nombre\r\nORDER BY 2 DESC;",
